# Project Config
PROJECT_NAME="Autonomous IT Support Agent"
VERSION="1.0.0"

# LLM Config (Local Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# Optional Cloud LLM (for online deployment e.g. Render / Railway)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=""
# Or OpenAI:
OPENAI_API_KEY=""

# Database (SQLite default for zero-friction setup, PostgreSQL supported)
DATABASE_URL="sqlite:///./it_support_agent.db"

# Security
SECRET_KEY="super-secret-it-support-agent-jwt-key-32chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Zammad Helpdesk Integration (Docker)
ZAMMAD_URL="http://localhost:8080"
ZAMMAD_TOKEN=""

