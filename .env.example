# Project Config
PROJECT_NAME="Autonomous IT Support Agent"
VERSION="1.0.0"

# LLM Config (Ollama local - Free & Open Source)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# Database
# Default: SQLite (runs instantly out of the box with zero external dependencies)
DATABASE_URL="sqlite:///./it_support_agent.db"
# Production PostgreSQL + pgvector option:
# DATABASE_URL="postgresql://it_agent:password123@localhost:5432/it_support_db"

# Security
SECRET_KEY="super-secret-it-support-agent-jwt-key-32chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional Cloud LLMs (Not required! System uses Ollama by default)
# OPENAI_API_KEY=""
# AZURE_OPENAI_API_KEY=""
# AZURE_OPENAI_ENDPOINT=""

# Optional LangSmith Tracing
LANGCHAIN_TRACING_V2="false"
# LANGCHAIN_API_KEY=""
# LANGCHAIN_PROJECT="autonomous-it-support"
